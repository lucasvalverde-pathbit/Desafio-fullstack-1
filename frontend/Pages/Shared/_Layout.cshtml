<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MeuSistema</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- CSS customizado -->
    <link rel="stylesheet" href="~/css/styles.css" />

    @if (ViewData["Stylesheet"] != null)
    {
    <link rel="stylesheet" href="~/css/@ViewData["Stylesheet"]" />
    }

</head>
<body class="d-flex flex-column min-vh-100">
    @RenderBody()

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script type="module" src="~/js/scripts.js"></script>

    @RenderSection("Scripts", required: false)

    <div id="customAlert" class="alert alert-info d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow" role="alert" style="z-index: 9999;">
        <span id="customAlertMessage">Mensagem</span>
    </div>

</body>
</html>
@page
@model AdminModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Painel de Administração";
    ViewData["Stylesheet"] = "admin.css";

}

<header class="border-bottom py-3 px-4 d-flex flex-wrap justify-content-between align-items-center">
    <div>
        <button id="profileBtn" class="btn">👤 <span class="span" id="nameDisplay"></span></button>
        <button id="logoutBtn" class="btn-cancel">Sair</button>
    </div>
    <h1 class="w-100 text-center my-3 text-dark">Bem-vindo Administrador!</h1>
</header>

<main class="container my-4 flex-grow-1">
    <section id="productSection" class="mb-5">
        <div class="d-flex flex-column flex-md-row gap-3 justify-content-center mb-3">
            <input id="productSearch" type="text" class="form-control w-100 w-md-50" placeholder="Buscar produto" />
            <button id="addProduct" class="btn w-100 w-md-auto">Adicionar Produto</button>
        </div>

        <div class="table-responsive">
            <table id="productList" class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nome</th>
                        <th>Preço</th>
                        <th>Quantidade em Estoque</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody><!-- Produtos inseridos aqui --></tbody>
            </table>
        </div>
        <div class="d-flex flex-column flex-md-row gap-3 justify-content-center mb-3"></div>
            <button id="orderListBtn" class="btn w-100 w-md-auto">Mostrar Pedidos</button>
        </div>
    </section>


    <section id="orderSection" class="d-none">
        <h2 class="text-center mb-3">Lista de Pedidos</h2>
        <div class="table-responsive">
            <table id="orderListTable" class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Produtos</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody><!-- Pedidos inseridos --></tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end mt-3">
            <button id="closeOrderSection" class="btn-cancel">Fechar</button>
        </div>
    </section>
</main>

<!-- Modal de Produto -->
<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="productForm" class="p-4">
                <h2 id="modalTitle" class="mb-4">Adicionar Produto</h2>
                <input type="hidden" id="id" />

                <div class="mb-3">
                    <label for="productName" class="form-label">Nome do Produto:</label>
                    <input type="text" id="productName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label for="price" class="form-label">Preço:</label>
                    <input type="number" step="0.01" id="price" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label for="quantityAvaliable" class="form-label">Quantidade em Estoque:</label>
                    <input type="number" id="quantityAvaliable" class="form-control" required />
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn">Salvar</button>
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/admin.js"></script>
}